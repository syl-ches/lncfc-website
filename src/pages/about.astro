---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="LNCFC | About">
  <Navbar />

  <main class="font-sans">
    <!-- Our Story Section -->
    <section class="w-full bg-white-background py-12 lg:py-24 px-6 sm:px-12 font-sans">
      <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-8 lg:gap-12">

        <!-- Title -->
        <h1 class="text-primary font-headline !text-[36px] md:!text-[48px] lg:!text-[68px] leading-tight">
          Our Story
        </h1>

        <p class="font-sans text-black leading-relaxed w-full !text-[14px] sm:!text-[15px] lg:!text-[18px]">
          The Light of the North Choral Festival and Competition (LNCFC) was 
          founded in 2024 by Mrs. Normita Rio-Pablico under Saint Louis University, 
          with the vision of promoting and celebrating the rich choral tradition of the 
          Philippines. It provides a meaningful platform for choirs to come together, share 
          their artistry, celebrate music, and build lasting connections through the beauty of choral singing. 
        </p>

        <!-- Image 1 (+25% size boost) -->
        <div class="w-full max-w-2xl mx-auto flex justify-center">
          <img 
            src="/images/our-story-1.webp" 
            alt="Light of the North Choral Performance" 
            class="w-full h-auto max-h-[394px] object-cover shadow-lg rounded-xl"  
          />
        </div>

        <p class="font-sans text-black leading-relaxed w-full !text-[14px] sm:!text-[15px] lg:!text-[18px]">
          The inaugural festival was held on November 30, 2024, at Fr. 
          Joseph Van den Daelen, CICM. Center for Culture and the Arts Theater, 
          bringing together 15 participating choirs from numerous provinces, cities, and 
          institutions. Featuring the Open Category and a Gala Concert of the SLU Glee Club 
          and The BAAO Children and Youth Choir, the first edition marked the beginning of a 
          growing tradition that highlighted the diversity and artistry of the choral community. 
          Its successful launch was made possible through the collaboration and support of the SLU 
          Administration led by Fr. Gilbert B. Sales, CICM., PhD., the organizing committee, and 
          our sponsors.
        </p>

        <!-- Image 2 (+25% size boost) -->
        <div class="w-full max-w-2xl mx-auto flex justify-center">
          <img 
            src="/images/our-story-2.webp" 
            alt="SLU Choir Ensemble" 
            class="w-full h-auto max-h-[394px] object-cover shadow-lg rounded-xl"
          />
        </div>

        <!-- Paragraphs Below Image 2 -->
        <div class="flex flex-col gap-6 lg:gap-10 w-full">
          <p class="font-sans text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
            Following the success of its inaugural edition, the Light of the North 
            Choral Festival and Competition returned for its second installment with a 
            renewed commitment to providing a meaningful platform for choral performance 
            and artistic exchange. Building upon the strong foundation established in its 
            first year, the festival continued to welcome participating choirs from across 
            the country while maintaining the spirit of excellence, camaraderie, and musical 
            collaboration that defined its beginnings. The second edition further strengthened 
            the festival's presence within the Philippine choral community, reaffirming its role 
            as a growing tradition that celebrates the artistry and dedication of choral musicians.
          </p>
          <p class="font-sans text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
            To date, the Light of the North Choral Festival and Competition 
            has welcomed 31 participating choirs, bringing together singers, conductors, 
            music educators, and audiences from across the country. Each edition has enriched 
            its growing legacy through artistic exchange, the celebration of diverse choral 
            traditions, and the strengthening of bonds within the choral community. 
            As the festival continues to evolve, it stands as a testament to the enduring 
            power of choral music and the collective efforts of the individuals, institutions, 
            and organizations who have shaped its journey since 2024. 
          </p>
        </div>

      </div>
    </section>

    <!-- Vision Section -->
    <section class="w-full bg-[#056F6C] py-12 lg:py-24 px-6 sm:px-12 font-sans">
      <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-6 lg:gap-8">
        <h2 class="font-headline text-white !text-[20px] md:!text-[22px] lg:!text-[26px]">
          Vision
        </h2>
        <p class="font-sans text-white leading-relaxed w-full !text-[14px] sm:!text-[15px] lg:!text-[18px]">
          To be a leading national platform for choral excellence, 
          fostering a vibrant and connected Filipino choral community where voices, 
          artistry, and shared passion for music inspire one another. 
        </p>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="w-full bg-white-background py-12 lg:py-24 px-6 sm:px-12 font-sans">
      <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-6 lg:gap-8">
        <h2 class="font-headline text-black !text-[20px] md:!text-[22px] lg:!text-[26px]">
          Mission
        </h2>
        <p class="font-sans text-black leading-relaxed w-full !text-[14px] sm:!text-[15px] lg:!text-[18px]">
          To provide a professional and inclusive platform 
          for choirs and vocalists to perform, learn, and grow through 
          meaningful competition, expert artistic feedback, cultural exchange, and community-building. 
        </p>
      </div>
    </section>

    <!-- Organizers Section -->
    <section class="w-full bg-[#E3A743] py-12 lg:py-24 px-6 sm:px-12 font-sans">
      <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-6 lg:gap-8">
        <h2 class="font-headline text-white !text-[20px] md:!text-[22px] lg:!text-[26px]">
          Organizers
        </h2>
        <p class="font-sans text-white leading-relaxed w-full !text-[14px] sm:!text-[15px] lg:!text-[18px]">
          Saint Louis University Glee Club and Saint Louis University Center for Culture and the Arts.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>