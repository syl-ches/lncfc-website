---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from '../components/Button.astro';
---

<Layout>
    <Navbar/>

      <!-- Hero Section -->
  <div class="relative w-full min-h-[720px] flex flex-col items-center justify-center overflow-hidden bg-black">
    <img 
      src="/images/guidelines-hero.png" 
      alt="LNCFC Hero Background" 
      class="absolute inset-0 w-full h-full object-cover z-0 opacity-60" 
    />

    <main class="relative z-10 px-6 text-center">
      <h1 
        style="color: var(--color-text-white);" 
        class="drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] mb-8"
      >
        Competition Guidelines & Mechanics
      </h1>
      
      

    </main>
  </div>

  <!-- Categories Section -->
<section class="w-full bg-white py-[40px] px-[20px] lg:py-[90px] lg:px-[50px]">
  <div class="max-w-[1123px] mx-auto flex flex-col items-start text-left gap-6 lg:gap-8">

    <!-- Primary Headings (Aligned Left Edge) -->
    <div class="flex flex-col gap-2 w-full">
      <h2 class="text-primary font-headline text-left">
        Categories
      </h2>
      <h3 class="text-gray-900 font-headline text-left">
        Open Choir Category
      </h3>
    </div>

    <!-- Content Block (Indented slightly: pl-4 sm:pl-8) -->
    <div class="flex flex-col gap-6 w-full text-gray-800 pl-4 sm:pl-8 border-l-2 border-gray-100">

      <!-- Eligibility -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Eligibility</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">The competing choir must have a minimum number of twenty (20) singers and a maximum of forty (40) singers, excluding the conductor.</h4>
          </li>
          <li>
            <h4 class="inline">No age limit is set for this category.</h4>
          </li>
        </ul>
      </div>

      <!-- Time limit -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Time limit</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">The participating choirs are expected to perform within a maximum duration of twelve (12) minutes per category. The time begins with the first sung note and ends on the last note (pitched or unpitched).</h4>
          </li>
        </ul>
      </div>

      <!-- Repertoire requirements -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Repertoire requirements</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">One (1) sacred composition from the Baroque Era (1600-1750), Classical Era (1750-1820), or Romantic Era (1800-1910);</h4>
          </li>
          <li>
            <h4 class="inline">One (1) folk song or indigenous music from any other country.</h4>
          </li>
        </ul>
      </div>

      <!-- Performance rules -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Performance rules</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">All songs should be performed a cappella.</h4>
          </li>
          <li>
            <h4 class="inline">All pieces may be accompanied by unpitched instruments.</h4>
          </li>
          <li>
            <h4 class="inline">The use of instruments must first be confirmed with the LNCFC Committee Organizers.</h4>
          </li>
        </ul>
      </div>

      <!-- Judging criteria -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Judging criteria</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">40% - Technical Proficiency (Blending and Balance, Accuracy of Pitch, Intonation and Rhythm, Tone Color and Choral Sound)</h4>
          </li>
          <li>
            <h4 class="inline">40% - Artistic Performance (Adherence to the score, Interpretation, Phrasing and Musicality)</h4>
          </li>
          <li>
            <h4 class="inline">20% - Overall Artistic Impression</h4>
          </li>
        </ul>
      </div>

      <!-- Awards -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold text-gray-900">Awards</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline">Champion - Fifty Thousand Pesos (Php 50,000.00) and a Trophy</h4>
          </li>
          <li>
            <h4 class="inline">1st runner up - Forty Thousand Pesos (Php 40,000.00) and a Trophy</h4>
          </li>
          <li>
            <h4 class="inline">2nd runner up - Thirty Thousand Pesos (Php 30,000.00) and a Trophy</h4>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>

<!-- Vocal Solo Category Section -->
<section class="w-full bg-[#14102B]/60 py-[40px] px-[20px] lg:py-[90px] lg:px-[50px]">
  <div class="max-w-[1123px] mx-auto flex flex-col items-start text-left gap-6 lg:gap-8">

    <!-- Subcategory Heading (Aligned Left Edge) -->
    <div class="flex flex-col gap-2 w-full">
      <h3 class="!text-white font-headline text-left">
        Vocal Solo Category
      </h3>
    </div>

    <!-- Content Block (Indented: pl-4 sm:pl-8) -->
    <div class="flex flex-col gap-6 w-full !text-white pl-4 sm:pl-8 border-l-2 border-white/20">

      <!-- Eligibility -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold !text-white">Eligibility</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline !text-white">The Vocal Solo Category is open to non-professional singers aged 12 to 40 years old.</h4>
          </li>
        </ul>
      </div>

      <!-- Song requirements -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold !text-white">Song requirements</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline !text-white">The song to be rendered is any Original Pilipino Music (OPM) song with a maximum duration of six (6) minutes.</h4>
          </li>
        </ul>
      </div>

      <!-- Performance rules -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold !text-white">Performance rules</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline !text-white">Performances must be accompanied by a canned music. Live accompaniment is not permitted.</h4>
          </li>
          <li>
            <h4 class="inline !text-white">The song accompaniment must not contain any lead or backing vocals.</h4>
          </li>
          <li>
            <h4 class="inline !text-white">Songs must be performed in their original key. Transposition is not allowed.</h4>
          </li>
          <li>
            <h4 class="inline !text-white">Medleys and mash-ups are strictly prohibited.</h4>
          </li>
        </ul>
      </div>

      <!-- Judging criteria -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold !text-white">Judging criteria</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline !text-white">30% - Tone Production</h4>
          </li>
          <li>
            <h4 class="inline !text-white">30% - Interpretation</h4>
          </li>
          <li>
            <h4 class="inline !text-white">30% - Technique</h4>
          </li>
          <li>
            <h4 class="inline !text-white">10% - Overall Performance</h4>
          </li>
        </ul>
      </div>

      <!-- Awards -->
      <div class="flex flex-col gap-2">
        <h4 class="font-bold !text-white">Awards</h4>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            <h4 class="inline !text-white">Champion - Fifteen Thousand Pesos (Php 15,000) and a Trophy</h4>
          </li>
          <li>
            <h4 class="inline !text-white">1st runner up - Ten Thousand Pesos (Php 10,000) and a Trophy</h4>
          </li>
          <li>
            <h4 class="inline !text-white">2nd runner up - Seven Thousand and Five Hundred Pesos (Php 7,500) and a Trophy</h4>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>

<Footer/>


</Layout>