---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from '../components/Button.astro';
---

<Layout title='LNCFC | Contact'>
  <Navbar/>

  <main class="font-sans">
    <!-- Contact Us Section -->
    <section class="w-full bg-white py-12 px-6 md:px-12 lg:px-16 text-center xl:text-left font-sans">
      <div class="max-w-[1200px] mx-auto flex flex-col gap-8 items-center xl:items-start">
        
        <!-- Header (Scaled Down to match Page Title sizes) -->
        <h1 class="text-gray-900 font-headline !text-[24px] md:!text-[36px] lg:!text-[48px] leading-tight text-center xl:text-left">
          Contact Us
        </h1>

        <!-- Content Details -->
        <div class="flex flex-col gap-6 text-gray-800 w-full items-center xl:items-start">
          
          <!-- For Inquiries and Registration Concerns -->
          <div class="space-y-2 w-full flex flex-col items-center xl:items-start">
            <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px] text-center xl:text-left">
              <span class="text-highlight-yellow">For inquiries and registration concerns:</span>
            </p>
            <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700 text-center xl:text-left">
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  Email: 
                  <a 
                    href="mailto:slulightofthenorth@slu.edu.ph" 
                    class="underline hover:text-highlight-yellow transition-colors"
                    target="_blank" 
                    rel="noopener noreferrer"
                  >
                    slulightofthenorth@slu.edu.ph
                  </a>
                </p>
              </li>
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  Contact Number: +63 917 505 0218
                </p>
              </li>
            </ul>
          </div>

          <!-- Social Media -->
          <div class="space-y-2 w-full flex flex-col items-center xl:items-start">
            <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px] text-center xl:text-left">
              <span class="text-highlight-yellow">Social Media:</span>
            </p>
            <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700 text-center xl:text-left">
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  Facebook: Light of the North Choral Festival and Competition
                </p>
              </li>
            </ul>
          </div>

          <!-- Venue -->
          <div class="space-y-2 w-full flex flex-col items-center xl:items-start">
            <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px] text-center xl:text-left">
              <span class="text-highlight-yellow">Venue:</span>
            </p>
            <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700 text-center xl:text-left">
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  Saint Louis University Center for Culture and the Arts
                </p>
              </li>
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  SLU Main Campus, Upper Bonifacio Street, Baguio City, Philippines
                </p>
              </li>
            </ul>
          </div>

          <!-- Organizing Committee -->
          <div class="space-y-2 w-full flex flex-col items-center xl:items-start">
            <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px] text-center xl:text-left">
              <span class="text-highlight-yellow">Organizing Committee:</span>
            </p>
            <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700 text-center xl:text-left">
              <li>
                <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[18px]">
                  For festival-related inquiries, please contact the LNCFC Organizing Committee through the official email or contact number above.
                </p>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </section>
  </main>

  <Footer/>
</Layout>