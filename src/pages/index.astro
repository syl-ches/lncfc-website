---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from '../components/Button.astro';
---

<Layout title="LNCFC | Home">
  <Navbar />

  <!-- Hero Section -->
  <div class="relative w-full min-h-[320px] sm:min-h-[400px] lg:min-h-[460px] py-10 flex flex-col items-center justify-center overflow-hidden bg-black font-sans">
    <img 
      src="/images/home-hero.webp" 
      alt="LNCFC Hero Background" 
      class="absolute inset-0 w-full h-full object-cover object-center z-0 opacity-60 pointer-events-none" 
    />

    <main class="relative z-10 px-6 max-w-3xl mx-auto text-center">
      <h1 
        style="color: var(--color-text-white);" 
        class="animate-float drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] mb-3 !text-[20px] sm:!text-[24px] md:!text-[30px] lg:!text-[34px] leading-tight font-bold font-headline"
      >
        Applications for LNCFC 2026 are Open
      </h1>
      <p 
        style="color: var(--color-text-white);" 
        class="animate-float drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] !text-[13px] sm:!text-[14px] md:!text-[15px] leading-snug font-normal font-sans"
      >
        Let our harmonies be one light with the North!
      </p>
    </main>
  </div>

  <!-- About Section -->
  <section class="w-full bg-white-background py-10 lg:py-12 px-6 sm:px-12 font-sans">
    <div class="max-w-6xl mx-auto grid grid-cols-1 xl:grid-cols-[35%_65%] gap-6 lg:gap-10 items-center text-center xl:text-left">
      
      <!-- Image Wrapper -->
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out w-full max-w-[360px] xl:max-w-none mx-auto flex justify-center">
        <img 
          src="/images/light-of-the-north.webp" 
          alt="LNCFC Event" 
          class="w-full h-auto object-cover shadow-lg rounded-xl"
        />
      </div>

      <!-- Text Container -->
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out flex flex-col gap-3 font-sans">
        <p class="text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
          The <span class="text-highlight-yellow font-semibold">Light of the North Choral Festival and Competition (LNCFC)</span> is a premier national 
          choral event organized by <span class="text-highlight-yellow font-semibold">Saint Louis University</span> through its <span class="text-highlight-yellow font-semibold">
            Center for Culture and the Arts.</span> Since its inaugural season in 2024, LNCFC has become a leading choral gathering in 
          the Cordilleras, bringing together choirs from across the Philippines to celebrate 
          artistic excellence, cultural exchange, and the nation's rich choral tradition. 
        </p>
        <p class="text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
            Celebrating the CICM Foundation Anniversary, the Light of the North Choral 
            Festival and Competition returns on November 29, 2026 at the Prince Bernhard 
            Gym and Fr. Joseph van den Daelen, CICM CCA Theater, Saint Louis University, 
            Baguio City. Now in its third season, LNCFC continues to unite choirs from across 
            the country in a celebration of artistic excellence and Philippine choral music. 
        </p>
      </div>

    </div>
  </section>

  <!-- Centered Single-Column Section -->
  <section class="w-full bg-white-background py-10 px-6 sm:px-12 font-sans">
    <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-5">
      
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <h2 class="font-headline text-black !text-[20px] sm:!text-[22px] lg:!text-[26px]">
          Revisiting the best of LNCFC 2025
        </h2>
      </div>

      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out w-full max-w-3xl">
        <img 
          src="/images/placeholder.webp" 
          alt="Festival Highlights" 
          class="w-full h-[220px] sm:h-[300px] md:h-[360px] object-cover shadow-lg rounded-xl"
        />
      </div>

      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out flex flex-col gap-3 max-w-3xl w-full font-sans">
        <p class="text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
          Last 2025, the Light of the North Choral Festival and Competition 
          brought together 15 outstanding choirs from across the country, each 
          showcasing exceptional talent and passion. Relive the memorable performances and 
          inspiring moments that made the festival truly unforgettable.
        </p>
        <p class="text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
          This year, on <span class="text-highlight-yellow font-bold">NOVEMBER 29, 2026</span>, the 3rd Light of the 
          North Choral Festival and Competition returns to the stage. 
          Experience a new level of choral excellence and artistic expression 
          as we return with exciting opportunities and the launch of a new 
          competition category.
        </p>
      </div>

    </div>
  </section>

  <!-- Sponsors & Partners Section -->
  <section class="w-full bg-[#A75933] py-10 lg:py-12 px-6 sm:px-12 font-sans">
    <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-5">
      
      <div class="reveal-left">
        <h2 class="font-headline text-white !text-[20px] sm:!text-[22px] lg:!text-[26px]">
          Sponsors & Partners
        </h2>
      </div>

      <div class="reveal-left opacity-0 translate-y-8 transition-all duration-700 ease-out max-w-3xl w-full">
        <p class="text-white leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
          The Light of the North Choral Festival and Competition is made possible through the generous support and partnership of organizations that share our commitment to advancing choral excellence.
        </p>
      </div>

      <div class="reveal-left opacity-0 translate-y-8 transition-all duration-700 ease-out">
        <img 
          src="/images/bcc-logo.webp" 
          alt="Sponsors and Partners Logos" 
          class="w-full max-w-xs sm:max-w-sm h-auto object-contain"
        />
      </div>
      
    </div>
  </section>

<!-- Application Period Section -->
<section class="w-full bg-white-background py-12 sm:py-16 lg:py-20 px-4 sm:px-12 font-sans mb-8 sm:mb-12 lg:mb-16">
  <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-6 sm:gap-8">
    
    <div class="reveal-on-scroll">
      <h2 class="font-headline text-black !text-[20px] sm:!text-[22px] lg:!text-[26px]">
        Application Period
      </h2>
    </div>

    <!-- Scaled Image for Mobile -->
    <div class="reveal-on-scroll flex justify-center w-full">
      <img 
        src="/images/deadline-application.webp" 
        alt="Festival Highlights" 
        class="w-[85%] max-w-[280px] sm:max-w-[400px] lg:max-w-[480px] h-auto object-cover shadow-md rounded-xl"
      />
    </div>

    <div class="reveal-on-scroll max-w-3xl w-full">
      <p class="text-black leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
        Applications for the Light of the North Choral Festival and Competition 2026 
        will be accepted from <span class="text-highlight-yellow font-semibold">June 10, 2026, to August 30, 2026</span>. Interested choirs are 
        encouraged to submit their applications within the registration period to secure 
        their participation in this year's festival.
      </p>
    </div>

    <div class="reveal-on-scroll">
      <Button href="/application">
        Submit an Application
      </Button>
    </div>
  </div>
</section>

<!-- Venue Highlights Section -->
<section class="w-full bg-[#E3A743] py-[90px] px-6 sm:px-12 font-sans flex items-center justify-center">
  <div class="max-w-6xl mx-auto flex flex-col gap-6 sm:gap-8 w-full">

    <div class="reveal-on-scroll w-full text-center xl:text-left">
      <h2 class="font-headline text-white !text-[20px] sm:!text-[22px] lg:!text-[26px]">
        Venues
      </h2>
    </div>

    <!-- Content Row 1 -->
    <div class="grid grid-cols-1 xl:grid-cols-[35%_65%] gap-6 lg:gap-10 items-center text-center xl:text-left font-sans">
      <div class="reveal-on-scroll w-full max-w-[360px] xl:max-w-none mx-auto flex justify-center">
        <img 
          src="/images/pb-gym.webp" 
          alt="Prince Bernhard Gymnasium" 
          class="w-full h-auto object-cover rounded-[16px] shadow-lg"
        />
      </div>

      <div class="reveal-on-scroll flex flex-col justify-center gap-3 font-sans">
        <p class="text-white leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[16px] font-normal font-sans">
          The Open Choral Category will take place at the Prince Bernhard Gymnasium, a spacious venue capable of accommodating large audiences while providing an inspiring stage for choirs to showcase their artistry and musical excellence.
          Likewise, the Vocal Solo Category will also be hosted at the Prince Bernhard Gymnasium.
        </p>
      </div>
    </div>

  </div>
</section>

  <Footer/>

</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll(".reveal-on-scroll, .reveal-left, .reveal-right").forEach((el) => {
      observer.observe(el);
    });
  });
</script>
