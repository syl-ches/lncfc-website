---
// src/pages/hall-of-fame.astro
import Layout from '../layouts/Layout.astro';
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Button from '../components/Button.astro';
---

<Layout title="LNCFC | Hall of Fame">
  <Navbar />

  <main class="font-sans">
    <!-- Hero Section -->
    <div class="relative w-full min-h-[320px] md:min-h-[420px] lg:min-h-[500px] flex flex-col items-center justify-center overflow-hidden bg-primary font-sans">
      <img 
        src="/images/hall-hero.webp" 
        alt="LNCFC Hero Background" 
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-75" 
      />

      <div class="animate-float relative z-10 px-6 text-center max-w-[1123px] mx-auto">
        <h1 
          style="color: var(--color-text-white);" 
          class="drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] mb-3 font-headline !text-[24px] md:!text-[36px] lg:!text-[48px] leading-tight text-center"
        >
          Hall of Fame
        </h1>
        <p 
          style="color: var(--color-text-white);" 
          class="drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] font-sans !text-[14px] md:!text-[16px] lg:!text-[20px] text-center"
        >
          Let our harmonies be one light with the North!
        </p>
      </div>
    </div>

    <!-- Winners Section -->
    <section class="relative w-full bg-white py-12 px-[20px] lg:py-20 lg:px-[55px] overflow-hidden font-sans">
      <!-- Section Background Image -->
      <img 
        src="/images/hof-bg.webp" 
        alt="Hall of Fame Section Background" 
        class="absolute inset-0 w-full h-full object-cover pointer-events-none z-0" 
      />

      <!-- Content Wrapper -->
      <div class="relative z-10 w-full flex flex-col gap-16 lg:gap-24">

        <!-- Row 1: 2024 -->
        <div class="flex flex-col gap-6 w-full items-center xl:items-start">
          <h2 class="reveal-on-scroll text-center xl:text-left font-headline text-gray-900 !text-[24px] md:!text-[32px] lg:!text-[40px] w-full">
            <span class="text-highlight-yellow">2024</span>
          </h2>
          
          <div class="flex flex-col xl:flex-row items-center xl:items-start gap-8 xl:gap-12 w-full">
            <!-- Image with Scale Animation & Hover Effect -->
            <div class="reveal-scale group w-full xl:w-[420px] shrink-0 flex justify-center overflow-hidden rounded-xl shadow-lg">
              <img 
                src="/images/feu.webp" 
                alt="LNCFC 2024 Winners" 
                class="w-full max-w-[420px] h-auto object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <!-- Staggered Details -->
            <div class="flex flex-col gap-6 w-full text-gray-800 text-center xl:text-left items-center xl:items-start">
              
              <!-- 2nd Runner-Up -->
              <div class="reveal-on-scroll delay-100 space-y-1 w-full flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px]">
                  <span class="text-highlight-yellow">2nd Runner-Up:</span> University of Baguio Voices Chorale
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. John Glenn Gaerlan
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Ili-ili by Ily Matthew Maniano; Pal Seo Song by Hyo-Won Woo
                    </p>
                  </li>
                </ul>
              </div>

              <!-- 1st Runner-Up -->
              <div class="reveal-on-scroll delay-200 space-y-1 w-full flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px]">
                  <span class="text-highlight-yellow">1st Runner-Up:</span> Tarlac Männerchor
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. Jero Anthony Buenviaje
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Jubilate Deo by Mark Raeniel B. Agpasa; Didn’t my Lord Deliver by Aaron Dale
                    </p>
                  </li>
                </ul>
              </div>

              <!-- Grand Champion Highlight Box -->
              <div class="reveal-on-scroll delay-300 space-y-1 w-full p-4 rounded-xl bg-amber-500/10 border border-amber-400/40 shadow-sm flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[16px] sm:!text-[17px] lg:!text-[19px]">
                  <span class="text-highlight-yellow">Grand Champion:</span> Far Eastern University Chorale
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. Roijin Galauran Suarez
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Ang Tren by Saunder Choi; O Magnum Mysterium by Andrej Makor
                    </p>
                  </li>
                </ul>
              </div>

            </div>
          </div>
        </div>

        <!-- Row 2: 2025 -->
        <div class="flex flex-col gap-6 w-full items-center xl:items-end">
          <h2 class="reveal-on-scroll text-center xl:text-right font-headline text-gray-900 !text-[24px] md:!text-[32px] lg:!text-[40px] w-full">
            <span class="text-highlight-yellow">2025</span>
          </h2>
          
          <div class="flex flex-col xl:flex-row-reverse items-center xl:items-start gap-8 xl:gap-12 w-full">
            <!-- Image with Scale Animation & Hover Effect -->
            <div class="reveal-scale group w-full xl:w-[420px] shrink-0 flex justify-center overflow-hidden rounded-xl shadow-lg">
              <img 
                src="/images/bcu.webp" 
                alt="LNCFC 2025 Winners" 
                class="w-full max-w-[420px] h-auto object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <!-- Staggered Details -->
            <div class="flex flex-col gap-6 w-full text-gray-800 text-center xl:text-left items-center xl:items-start">
              
              <!-- 2nd Runner-Up -->
              <div class="reveal-on-scroll delay-100 space-y-1 w-full flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px]">
                  <span class="text-highlight-yellow">2nd Runner-Up:</span> Tarlac Männerchor
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. Darwin B. Vargas
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Penitensya, Ian Gabriel T. Corpuz; Didn’t My Lord Deliver Daniel by Aaron Dale
                    </p>
                  </li>
                </ul>
              </div>

              <!-- 1st Runner-Up -->
              <div class="reveal-on-scroll delay-200 space-y-1 w-full flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[15px] sm:!text-[16px] lg:!text-[18px]">
                  <span class="text-highlight-yellow">1st Runner-Up:</span> Adamson University Chorale
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. John Rufiel G. Aniceto
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Cum Sancto Spiritus by Hyo Won Woo; Papedsalamat by Nilo Alcala III
                    </p>
                  </li>
                </ul>
              </div>

              <!-- Grand Champion Highlight Box -->
              <div class="reveal-on-scroll delay-300 space-y-1 w-full p-4 rounded-xl bg-amber-500/10 border border-amber-400/40 shadow-sm flex flex-col items-center xl:items-start">
                <p class="font-sans font-bold text-gray-900 !text-[16px] sm:!text-[17px] lg:!text-[19px]">
                  <span class="text-highlight-yellow">Grand Champion:</span> Baguio Central University Chamber Choir
                </p>
                <ul class="list-none xl:list-disc pl-0 xl:pl-6 space-y-1 text-gray-700">
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Conductor:</strong> Mr. Jomard L. Calamba
                    </p>
                  </li>
                  <li>
                    <p class="font-sans text-gray-800 leading-relaxed !text-[14px] sm:!text-[15px] lg:!text-[17px]">
                      <strong>Repertoire:</strong> Māte Saule by Jānis Peters; I Will Lift My Eyes by Zachary J. Moore
                    </p>
                  </li>
                </ul>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll(".reveal-on-scroll, .reveal-left, .reveal-right, .reveal-scale").forEach((el) => {
      observer.observe(el);
    });
  });
</script>