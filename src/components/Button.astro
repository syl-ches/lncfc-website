---
// src/components/Button.astro
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const { href, type = "button", class: className = "" } = Astro.props;

const buttonStyles = `
  w-full max-w-[320px] h-[42px] md:h-[48px] lg:h-[52px] 
  bg-primary hover:opacity-90 
  flex items-center justify-center text-center 
  rounded-[10px] md:rounded-[12px] transition-all duration-200 
  px-4 md:px-6 shadow-md cursor-pointer
  ${className}
`.trim();
---

{
  href ? (
    <a href={href} class={buttonStyles}>
      <span class="text-text-white font-headline !text-[14px] md:!text-[16px] lg:!text-[18px] leading-none tracking-wide">
        <slot />
      </span>
    </a>
  ) : (
    <button type={type} class={buttonStyles}>
      <span class="text-text-white font-headline !text-[14px] md:!text-[16px] lg:!text-[18px] leading-none tracking-wide">
        <slot />
      </span>
    </button>
  )
}