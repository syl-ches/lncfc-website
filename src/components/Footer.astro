---
// src/components/Footer.astro
---

<footer class="w-full bg-primary py-6 px-5 lg:py-8 lg:px-12 font-sans">
  <!-- Single container stacking everything to the left -->
  <div class="flex flex-col items-start text-left gap-4 max-w-7xl mx-auto">
    
    <!-- Title (Scaled Down) -->
    <h3 class="!text-white text-left font-headline leading-tight !text-[18px] sm:!text-[22px] md:!text-[28px]">
      Light of the North Choral Festival and <br class="hidden sm:inline" />Competition
    </h3>

    <!-- Left-aligned stack: Socials -> Email -> Address -->
    <div class="flex flex-col items-start text-left gap-2">
      
      <!-- Social Icons Group (Side-by-side) -->
      <div class="flex items-center gap-3 mb-1">
        <a 
          href="https://www.facebook.com/61560293711524" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center shrink-0 hover:opacity-80 transition-opacity"
        >
          <img src="/images/facebook.webp" alt="Facebook" class="h-5 w-auto md:h-6 object-contain" />
        </a>

        <a 
          href="https://www.instagram.com/theslu.gleeclub/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center shrink-0 hover:opacity-80 transition-opacity"
        >
          <img src="/images/instagram.webp" alt="Instagram" class="h-5 w-auto md:h-6 object-contain" />
        </a>
      </div>

      <!-- Email Link (Scaled Down) -->
      <a 
        href="mailto:slulightofthenorth@gmail.com" 
        class="inline-block relative z-10 hover:underline cursor-pointer"
      >
        <p class="!text-white text-left leading-normal !text-[13px] md:!text-[15px] font-sans">
          slulightofthenorth@gmail.com
        </p>
      </a>

      <!-- Address Text (Scaled Down) -->
      <p class="!text-white text-left leading-snug !text-[12px] md:!text-[14px] font-sans text-gray-200">
        SLU Main Campus, A. Bonifacio Street, <br />Baguio City, Philippines
      </p>

    </div>

  </div>
</footer>