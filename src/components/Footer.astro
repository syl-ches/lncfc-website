---
// src/components/Footer.astro
---

<nav class="w-full bg-primary py-[40px] px-[20px] lg:py-[45px] lg:px-[50px]">
  <!-- Single container stacking everything to the left -->
  <div class="flex flex-col items-start text-left gap-6 lg:gap-[20px] max-w-7xl">
    
    <!-- Title -->
    <h2 class="!text-white text-left leading-relaxed !text-[24px] md:!text-[48px]">
      Light of the North Choral Festival and <br class="hidden sm:inline" />Competition
    </h2>

    <!-- Left-aligned stack: Socials -> Email -> Address -->
    <div class="flex flex-col items-start text-left gap-3">
      
      <!-- Social Icons Group (Side-by-side) -->
      <div class="flex items-center gap-4">
        <a 
          href="https://www.facebook.com/61560293711524" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center shrink-0 hover:opacity-80 transition-opacity"
        >
          <img src="/images/facebook.png" alt="Facebook" class="h-6 w-auto md:h-8 object-contain" />
        </a>

        <a 
          href="https://www.instagram.com/theslu.gleeclub/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center shrink-0 hover:opacity-80 transition-opacity"
        >
          <img src="/images/instagram.png" alt="Instagram" class="h-6 w-auto md:h-8 object-contain" />
        </a>
      </div>

      <!-- Email Link -->
      <a 
        href="mailto:slulightofthenorth@gmail.com" 
        class="inline-block relative z-10 hover:underline cursor-pointer"
      >
        <h5 class="!text-white text-left leading-relaxed !text-[16px] md:!text-[24px]">
          slulightofthenorth@gmail.com
        </h5>
      </a>

      <!-- Address Text -->
      <h5 class="!text-white text-left leading-relaxed !text-[14px] md:!text-[24px]">
        SLU Main Campus, A. Bonifacio Street, <br />Baguio City, Philippines
      </h5>

    </div>

  </div>
</nav>