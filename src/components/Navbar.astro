---
// src/components/Navbar.astro
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/guidelines", label: "Mechanics" },
  { href: "/application", label: "Application" },
  { href: "/hall-of-fame", label: "Hall of Fame" },
  { href: "/contact", label: "Contact Us" },
];
---

<nav class="sticky top-0 z-50 w-full bg-primary py-5 px-4 sm:px-6">
  <!-- Grid layout centers the middle container relative to the full viewport width -->
  <div class="relative w-full max-w-[1440px] mx-auto grid grid-cols-[auto_1fr] lg:grid-cols-[200px_1fr_200px] items-center">
    
    <!-- Left: Logo -->
    <div class="flex items-center justify-start">
      <a href="/" class="flex items-center shrink-0">
        <img src="/images/logo-gold.png" alt="LNCFC Logo" class="h-10 w-auto" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center justify-center gap-4 xl:gap-8 min-[1311px]:gap-[75px] whitespace-nowrap">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || currentPath === `${link.href}/`;
        return (
          <a 
            href={link.href} 
            class={`font-headline !text-[20px] not-italic transition-colors hover:text-highlight-yellow ${
              isActive ? 'text-highlight-yellow' : 'text-text-white'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <div class="flex items-center justify-end">
      <div class="hidden lg:block w-10"></div>

      <!-- Mobile Hamburger Button -->
      <button 
        id="menu-toggle"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
        class="lg:hidden text-text-white hover:text-highlight-yellow focus:outline-none p-2 relative z-50"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Slide-out Menu Panel (Anchored top-right under the button) -->
    <div 
      id="mobile-menu" 
      class="lg:hidden absolute top-full right-0 mt-3 w-64 bg-primary border border-white/10 rounded-2xl p-6 shadow-2xl flex flex-col items-end gap-4 text-right origin-top-right transition-all duration-300 opacity-0 scale-95 pointer-events-none z-50"
    >
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || currentPath === `${link.href}/`;
        return (
          <a 
            href={link.href} 
            class={`font-headline !text-[18px] not-italic transition-colors hover:text-highlight-yellow py-1 w-full text-right ${
              isActive ? 'text-highlight-yellow' : 'text-text-white'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

  </div>
</nav>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  let isOpen = false;

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    isOpen = !isOpen;

    toggleBtn.setAttribute('aria-expanded', isOpen.toString());

    if (isOpen) {
      mobileMenu?.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      mobileMenu?.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
    } else {
      mobileMenu?.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      mobileMenu?.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    }
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (isOpen && !mobileMenu?.contains(e.target as Node) && !toggleBtn?.contains(e.target as Node)) {
      isOpen = false;
      toggleBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
      mobileMenu?.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    }
  });
</script>